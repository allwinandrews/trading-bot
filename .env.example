# Copy this file to .env and fill in real values. Never commit .env itself.

# Interactive Brokers (execution/ — paper or live trading via TWS/IB Gateway)
# Socket port depends on which app AND which mode you're running:
#   IB Gateway paper = 4002 (default here)   IB Gateway live = 4001
#   TWS paper        = 7497                  TWS live        = 7496
IB_ACCOUNT_ID=
IB_HOST=127.0.0.1
IB_PORT=4002

# Gemini (for the AI trade-journal / sentiment layer) — get a free key at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
